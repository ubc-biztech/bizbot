# Environment Configuration Template for BizBot
# Copy this file to .env and fill in your actual values

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here

# AWS DynamoDB Configuration
AWS_REGION=us-west-2

# Ticket table suffix: empty uses biztechTickets; PROD uses biztechTicketsPROD.
# For the production Discord server, set this to PROD before starting.
ENVIRONMENT=

# Lightsail: supply credentials for a dedicated IAM principal scoped to the bot's
# DynamoDB tables. Lightsail does not support attaching an EC2 instance profile.
# Never use root credentials. Uncomment and fill these only when needed.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # Required only for temporary credentials; refresh before expiry.
